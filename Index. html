                        labels: priceHistory.map((_, i) => i),
                        datasets: [{
                            label: 'Price',
                            data: priceHistory,
                            borderColor: '#4f9cf7',
                            backgroundColor: 'rgba(79, 156, 247, 0.08)',
                            borderWidth: 2.5,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            tension: 0.25,
